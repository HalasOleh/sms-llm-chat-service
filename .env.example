# ---------------------------------------------------------------------------
# Copy to .env:  cp .env.example .env
#
# The values below are a working default: with them the application boots
# fully on mock providers, with no external account or key of any kind.
# ---------------------------------------------------------------------------

PORT=3000
NODE_ENV=development

# --- Database --------------------------------------------------------------
# Required. Locally: `docker compose up -d`.
DATABASE_URL=postgresql://sms:sms@localhost:5432/sms_llm_chat?schema=public

# --- SMS provider ----------------------------------------------------------
# mock   - sends nothing, only logs and keeps messages in memory (default)
# twilio - real delivery; requires the three variables below
SMS_PROVIDER=mock

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# The public URL Twilio posts the webhook to (e.g. https://xxxx.ngrok-free.app).
# Needed for signature verification, which is computed over the exact URL.
TWILIO_WEBHOOK_URL=

# --- LLM provider ----------------------------------------------------------
# mock   - deterministic answers, no network (default)
# openai - real calls; requires OPENAI_API_KEY
LLM_PROVIDER=mock

OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=10000

# --- Channel limits --------------------------------------------------------
# Outbound replies are truncated to this length, so one verbose model answer
# cannot turn into ten billed SMS segments.
SMS_MAX_LENGTH=320

# --- Admin -----------------------------------------------------------------
# The password is stored as a bcrypt hash, not plaintext. Generate your own:
#   npm run hash:password -- 'your-password'
# The hash below corresponds to the password "password".
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$10$28HuUTmTzaj.MOYprCKF/uQEmxQWsdQU3NHZNFRjiwbG1htP0Pj1C

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
